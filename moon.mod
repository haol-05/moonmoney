name = "haol-05/moonmoney"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/haol-05/moonmoney"

license = "Apache-2.0"

description = "Exact money and currency arithmetic for MoonBit: ISO 4217 minor units, allocation without losing a cent, tax, cash rounding, parsing and formatting"

keywords = [
  "money",
  "currency",
  "decimal",
  "finance",
  "iso4217",
  "rounding",
  "allocation",
  "billing",
]

preferred_target = "wasm"
